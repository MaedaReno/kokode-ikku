{
  "name": "kokode-ikku",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --host",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p .",
    "tunnel": "cloudflared tunnel --no-autoupdate --url http://localhost:8787"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/kaisei-tokumin": "^5.3.1",
    "@fontsource/potta-one": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/yuji-boku": "^5.3.1",
    "@fontsource/yuji-mai": "^5.3.1",
    "@fontsource/yuji-syuku": "^5.3.1",
    "express": "^5.3.0",
    "kuromoji": "^0.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true
}
